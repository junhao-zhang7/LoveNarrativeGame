  m_Name: WaterCupSequence
  m_EditorClassIdentifier: Assembly-CSharp::LoveNarrativeGame.Prototype.StorySequence
  storyId: campus-act-03
  chapterTitle: "\u7B2C\u4E09\u5E55 \xB7 \u6C34\u676F"
  sourceNotes: "2026-11-02\u4F5C\u8005\u4FEE\u8BA2\uFF1A\u8138\u7EA2\u5BF9\u89C6\u7279\u5199\u3001\u62D6\u628A\u64E6\u6C34\uFF0C\u4E24\u53E5\u8865\u64E6\u5BF9\u767D\u8FDB\u5165\u5C0F\u6E38\u620F\uFF1B16\u6BB5\u6B63\u6587\u3002"
  beats:
  - id: water-v2-00
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u7B2C\u4E09\u5E55 \xB7 \u6C34\u676F\n\u5F53\u65E5\u665A\u81EA\u4E60\uFF0C\u4E03\u73ED\u3002"
    shot: 9
    focus: 0.5
    fade: 1
  - id: water-v2-01
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u674E\u665A\u4E91\u628A\u521A\u63A5\u597D\u6C34\u7684\u676F\u5B50\u653E\u5728\u684C\u5B50\u5DE6\u4E0A\u89D2\uFF0C\u676F\u76D6\u8FD8\u6CA1\u62E7\u4E0A\u3002\n\u51CC\u8D6B\u5199\u7D2F\u4E86\uFF0C\u4F38\u4E86\u4E2A\u61D2\u8170\u3002"
    shot: 9
    focus: 0.5
    fade: 0
  - id: water-v2-02
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u624B\u81C2\u78B0\u5230\u4E86\u676F\u5B50\u3002\u6C34\u843D\u5411\u5730\u9762\uFF0C\u676F\u76D6\u6EDA\u4E86\u4E00\u5C0F\u6BB5\u3002\n\u674E\u665A\u4E91\u5F80\u540E\u6536\u4E86\u6536\u817F\u3002"
    shot: 10
    focus: 0.5
    fade: 0
  - id: water-v2-03
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u5BF9\u4E0D\u8D77\uFF0C\u5BF9\u4E0D\u8D77\uFF01\u78B0\u5230\u4F60\u6CA1\u6709\uFF1F"
    shot: 10
    focus: 0.5
    fade: 0
  - id: water-v2-04
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u6CA1\u6709\u3002"
    shot: 10
    focus: 0.5
    fade: 0
  - id: water-v2-05
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u4F60\u522B\u52A8\uFF0C\u6211\u6765\u3002"
    shot: 10
    focus: 0.5
    fade: 0
  - id: water-v2-06
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u4E24\u4EBA\u540C\u65F6\u5F2F\u4E0B\u8170\u3002\u4ED6\u5148\u62FE\u8D77\u676F\u5B50\uFF0C\u5979\u62AC\u8D77\u5934\uFF0C\u5218\u6D77\u4ECE\u8138\u4FA7\u6ED1\u5F00\u3002"
    shot: 11
    focus: 0.5
    fade: 0
  - id: water-v2-07
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u89C6\u7EBF\u78B0\u4E0A\u4E86\u4E00\u77AC\uFF0C\u4E24\u4EBA\u7684\u8138\u90FD\u6709\u4E9B\u53D1\u70ED\uFF0C\u53C8\u5404\u81EA\u79FB\u5F00\u3002"
    shot: 24
    focus: 0.5
    fade: 0
  - id: water-v2-08
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u676F\u76D6\u2026\u2026\u5728\u4F60\u90A3\u8FB9\u3002"
    shot: 11
    focus: 0.5
    fade: 0
  - id: water-v2-09
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u54E6\u3002"
    shot: 11
    focus: 0.5
    fade: 0
  - id: water-v2-10
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u4ED6\u628A\u676F\u5B50\u653E\u597D\uFF0C\u62FF\u7740\u676F\u76D6\u6123\u4E86\u534A\u79D2\uFF0C\u624D\u4E00\u8D77\u653E\u4E0B\u3002"
    shot: 11
    focus: 0.5
    fade: 0
  - id: water-v2-11
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u6211\u53BB\u62FF\u62D6\u628A\u3002"
    shot: 11
    focus: 0.5
    fade: 0
  - id: water-v2-12
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 1
    speaker: 
    text: "\u51CC\u8D6B\u62FF\u6765\u62D6\u628A\uFF0C\u628A\u5730\u4E0A\u7684\u6C34\u6162\u6162\u6536\u62E2\u3002"
    shot: 12
    focus: 0.5
    fade: 1
  - id: water-v2-15
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u6536\u62FE\u540E\uFF0C\u4ED6\u56DE\u5230\u5EA7\u4F4D\uFF0C\u7EC3\u4E60\u518C\u8FD8\u505C\u5728\u4F38\u61D2\u8170\u524D\u7684\u90A3\u9053\u9898\u3002"
    shot: 13
    focus: 0.5
    fade: 0
  - id: water-v2-16
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u4F60\u8896\u5B50\u4E5F\u6E7F\u4E86\u3002"
    shot: 13
    focus: 0.5
    fade: 0
  - id: water-v2-17
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u4ED6\u4F4E\u4E0B\u5934\uFF0C\u62FF\u5E72\u7684\u90A3\u53EA\u624B\u628A\u8896\u53E3\u5377\u4E86\u4E0A\u53BB\u3002"
    shot: 13
    focus: 0.5
    fade: 0

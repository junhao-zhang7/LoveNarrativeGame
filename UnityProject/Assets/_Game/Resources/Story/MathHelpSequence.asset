    shot: 22
    focus: 0.5
    fade: 0
  - id: math-v2-24
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u5BF9\u4E86\uFF0C\u4ECA\u5929\u5E2E\u4F60\u5E26\u7801\uFF0C\u4F60\u6253\u7B97\u600E\u4E48\u62A5\u7B54\u6211\uFF1F"

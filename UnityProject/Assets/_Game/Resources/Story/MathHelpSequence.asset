  storyId: campus-act-05
  chapterTitle: "\u7B2C\u4E94\u5E55 \xB7 \u8FD9\u9053\u9898"
  sourceNotes: "2026-11-02\uFF1A\u9ED8\u8BA4\u4E24\u4EBA\u5408\u4F5C\u63A8\u5BFC\uFF0C\u6570\u503C\u8F93\u5165\u4E3A\u53EF\u9009\u4E14\u53EF\u968F\u65F6\u8FD4\u56DE\u5408\u4F5C\uFF1B\u4FDD\u755929\u6BB5\u6B63\u6587\u4E0E\u540E\u7EED\u5BF9\u767D\u3002"
  beats:
  - id: math-v2-00
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u7B2C\u4E94\u5E55 \xB7 \u8FD9\u9053\u9898\n\u540C\u65E5\u665A\u81EA\u4E60\uFF0C\u4E03\u73ED\u3002"
    shot: 19
    focus: 0.5
    fade: 1
  - id: math-v2-01
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u674E\u665A\u4E91\u5728\u8349\u7A3F\u4E0A\u5212\u53BB\u4E00\u884C\uFF0C\u53C8\u6284\u4E86\u4E00\u904D\u9898\u76EE\u3002\n\u4E0B\u8BFE\u94C3\u54CD\uFF0C\u5979\u62FF\u7740\u672C\u5B50\u7AD9\u5230\u51CC\u8D6B\u65C1\u8FB9\u3002"
    shot: 19
    focus: 0.5
    fade: 0
  - id: math-v2-02
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u8FD9\u9053\u9898\u2026\u2026\u4F60\u80FD\u5E2E\u6211\u770B\u4E00\u4E0B\u5417\uFF1F\u6211\u7B97\u4E86\u597D\u51E0\u6B21\u3002"
    shot: 19
    focus: 0.5
    fade: 0
  - id: math-v2-03
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u670B\u53CB"
    text: "\u51CC\u8D6B\uFF0C\u51FA\u53BB\u8D70\u8D70\uFF1F\u95F7\u6B7B\u4E86\u3002"
    shot: 19
    focus: 0.5
    fade: 0
  - id: math-v2-04
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u51CC\u8D6B\u770B\u770B\u95E8\u53E3\uFF0C\u53C8\u770B\u770B\u9012\u6765\u7684\u672C\u5B50\u3002"
    shot: 19
    focus: 0.5
    fade: 0
  - id: math-v2-05
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u6CA1\u4E8B\uFF0C\u4F60\u53BB\u2014\u2014"
    shot: 19
    focus: 0.5
    fade: 0
  - id: math-v2-06
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u4F60\u4EEC\u5148\u53BB\uFF0C\u6211\u8FD9\u513F\u8FD8\u6709\u9053\u9898\u3002"
    shot: 19
    focus: 0.5
    fade: 0
  - id: math-v2-07
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u670B\u53CB\u70B9\u70B9\u5934\u3002\u51CC\u8D6B\u628A\u672C\u5B50\u653E\u5230\u4E24\u4EBA\u4E2D\u95F4\u3002"
    shot: 20
    focus: 0.5
    fade: 0
  - id: math-v2-08
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u4F60\u5148\u7B97\u51FA\u4EC0\u4E48\u4E86\uFF1F"
    shot: 20
    focus: 0.5
    fade: 0
  - id: math-v2-09
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u9876\u70B9\u662F\u516D\u3002\u6211\u5C31\u628A\u516D\u4EE3\u8FDB\u53BB\u4E86\uFF0C\u53EF\u7B97\u51FA\u6765\u8DDF\u7B54\u6848\u5DEE\u597D\u591A\u3002"
    shot: 20
    focus: 0.5
    fade: 0
  - id: math-v2-10
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B\uFF08\u5FC3\u58F0\uFF09"
    text: "f(x) = x\xB2 - 12x - 2\uFF0Cx\u2208[2,14]\u2026\u2026"
    shot: 21
    focus: 0.5
    fade: 0
  - id: math-v2-11
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B\uFF08\u5FC3\u58F0\uFF09"
    text: "M \u662F\u533A\u95F4\u5185\u7684\u6700\u5927\u503C\u2026\u2026\u6700\u5927\u503C\u3002\n\u5979\u628A\u9876\u70B9\u4EE3\u8FDB\u53BB\u4E86\uFF0C\u7B97\u6210\u4E86\u6700\u5C0F\u503C\u3002"
    shot: 21
    focus: 0.5
    fade: 0
  - id: math-v2-12
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B\uFF08\u5FC3\u58F0\uFF09"
    text: "m+n=26\uFF0Cmn=91\uFF0C\u6C42 M+m\xB2+n\xB2\u3002\n\u5148\u770B\u4E24\u7AEF\uFF0C\u518D\u7B97\u540E\u9762\u8FD9\u4E00\u9879\u3002"
    shot: 21
    focus: 0.5
    fade: 0
  - id: math-v2-13
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 3
    speaker: 
    text: "\u51CC\u8D6B\u628A\u7EC3\u4E60\u672C\u8F6C\u5230\u4E24\u4EBA\u4E2D\u95F4\u3002\u5148\u4E00\u8D77\u770B\u770B\uFF0C\u4E5F\u53EF\u4EE5\u81EA\u5DF1\u8BD5\u7740\u7B97\u3002"
    shot: 21
    focus: 0.5
    fade: 0
  - id: math-v2-14
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u4F60\u627E\u7684\u662F\u6700\u5C0F\u503C\u3002\u5B83\u95EE\u7684\u662F\u6700\u5927\u503C\uFF0C\u8FD8\u7ED9\u4E86\u533A\u95F4\u3002"
    shot: 21
    focus: 0.5
    fade: 0
  - id: math-v2-15
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u8FD9\u91CC\u662F\u8D1F\u4E8C\u5341\u4E8C\uFF0C\u8FD9\u91CC\u4E8C\u5341\u516D\u3002\u5F00\u53E3\u5411\u4E0A\uFF0C\u516D\u5728\u4E2D\u95F4\uFF0C\u6240\u4EE5\u6700\u5927\u7684\u662F\u4E8C\u5341\u516D\u3002"
    shot: 21
    focus: 0.5
    fade: 0
  - id: math-v2-16
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u89E3\u9898\u7B14\u8BB0"
    text: "f(2)=-22\uFF0Cf(14)=26\uFF0CM=26\u3002\n\u9876\u70B9\u6A2A\u5750\u6807\u4E3A6\uFF1B\u5F00\u53E3\u5411\u4E0A\uFF0C\u6BD4\u8F83\u533A\u95F4\u4E24\u7AEF\u3002"
    shot: 21
    focus: 0.5
    fade: 0
  - id: math-v2-17
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u540E\u9762\u4E0D\u7528\u628A m \u548C n \u5206\u522B\u89E3\u51FA\u6765\uFF1F"
    shot: 21
    focus: 0.5
    fade: 0
  - id: math-v2-18
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u4E0D\u7528\u3002\u548C\u7684\u5E73\u65B9\uFF0C\u51CF\u4E24\u500D\u7684\u79EF\u3002"
    shot: 21
    focus: 0.5
    fade: 0
  - id: math-v2-19
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u89E3\u9898\u7B14\u8BB0"
    text: "m\xB2+n\xB2=(m+n)\xB2-2mn\n=26\xB2-2\xD791=494\u3002"
    shot: 21
    focus: 0.5
    fade: 0
  - id: math-v2-20
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u56DB\u767E\u4E5D\u5341\u56DB\u2026\u2026\u518D\u52A0\u4E8C\u5341\u516D\uFF0C\u4E94\u767E\u4E8C\u5341\u3002"
    shot: 22
    focus: 0.5
    fade: 0
  - id: math-v2-21
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u5BF9\u3002"
    shot: 22
    focus: 0.5
    fade: 0
  - id: math-v2-22
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u4ED6\u50CF\u662F\u4E5F\u521A\u6CE8\u610F\u5230\u7ED3\u679C\uFF0C\u6E05\u4E86\u6E05\u55D3\u5B50\u3002\n\u5979\u4F4E\u5934\u628A\u6700\u540E\u4E00\u884C\u63CF\u6E05\u695A\u3002"
    shot: 22
    focus: 0.5
    fade: 0

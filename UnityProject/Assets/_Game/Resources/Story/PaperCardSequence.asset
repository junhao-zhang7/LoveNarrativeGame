    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u73ED\u4E3B\u4EFB"
    text: "\u4F60\u81EA\u5DF1\u7684\u5462\uFF1F\u522B\u5149\u987E\u7740\u800D\u5B9D\u3002"
    shot: 18
    focus: 0.5

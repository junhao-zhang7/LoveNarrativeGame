    text: "\u5728\uFF0C\u5728\u3002"
    shot: 18
    focus: 0.5
    fade: 0
  - id: card-v2-17
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u4ED6\u8D76\u7D27\u6478\u4E86\u6478\u53E3\u888B\uFF0C\u6536\u56DE\u6446\u59FF\u52BF\u7684\u624B\uFF0C\u8DDF\u4E0A\u961F\u4F0D\u3002"
    shot: 18
    focus: 0.5
    fade: 0
  - id: card-v2-18
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u79BB\u5F00\u4F53\u80B2\u9986\u65F6\uFF0C\u674E\u665A\u4E91\u56DE\u5934\u770B\u4E86\u4ED6\u4E00\u773C\u3002\n\u4ED6\u6B63\u628A\u7EB8\u5361\u91CD\u65B0\u6298\u8FDB\u515C\u91CC\u3002"

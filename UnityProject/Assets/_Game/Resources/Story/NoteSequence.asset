  storyId: campus-act-07
  chapterTitle: "\u7B2C\u4E03\u5E55 \xB7 \u56DE\u5BBF\u820D\u518D\u770B"
  sourceNotes: "MAIN_STORY_V0.3 MS-07\uFF1A\u539F\u5BF9\u767D\u4E0E\u5316\u5B66\u8C10\u97F3\uFF1B\u821E\u53F0\u6587\u5B57\u9002\u914D\u3002\u4F5C\u80052026-11-03\u8981\u6C42\u6682\u7F13\u7B2C\u516D\u5E55\u5148\u5236\u4F5C\u7B2C\u4E03\u5E55\uFF0C\u4FDD\u7559\u65F6\u95F4\u8DE8\u5EA6\uFF0C\u4E0D\u89C6\u4E3A\u5220\u6389\u7B2C\u516D\u5E55\u3002\u5BBF\u820D\u4E3A\u5168\u77E5\u7EBF\u6027\u6F14\u51FA\uFF1B\u5BA4\u53CB\u9020\u578B\u4E3A\u4E34\u65F6\u89C6\u89C9\u8865\u5145\u3002"
  beats:
  - id: note-v1-00
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u7B2C\u4E03\u5E55 \xB7 \u56DE\u5BBF\u820D\u518D\u770B\n\u4E00\u6BB5\u65E5\u5E38\u76F8\u5904\u4E4B\u540E\uFF0C\u665A\u81EA\u4E60\u7ED3\u675F\u3002"
    shot: 26
    focus: 0.5
    fade: 0
  - id: note-v1-01
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u674E\u665A\u4E91\u5728\u6536\u4E66\u3002\u51CC\u8D6B\u5C06\u4E00\u5F20\u7EB8\u4ECE\u672C\u5B50\u91CC\u62BD\u51FA\u6765\u3002"
    shot: 26
    focus: 0.5
    fade: 0
  - id: note-v1-02
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 4
    speaker: 
    text: "\u51CC\u8D6B\u628A\u7EB8\u6536\u597D\uFF0C\u51C6\u5907\u9012\u7ED9\u5979\u3002"
    shot: 26
    focus: 0.5
    fade: 0
  - id: note-v1-03
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u56DE\u5BBF\u820D\u518D\u770B\u3002"
    shot: 27
    focus: 0.5
    fade: 0
  - id: note-v1-04
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u4EC0\u4E48\u554A\uFF1F"
    shot: 27
    focus: 0.5
    fade: 0
  - id: note-v1-05
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u51CC\u8D6B"
    text: "\u53CD\u6B63\u4E0D\u662F\u4F5C\u4E1A\u3002"
    shot: 27
    focus: 0.5
    fade: 0
  - id: note-v1-06
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u5979\u8FD8\u60F3\u95EE\uFF0C\u4ED6\u5DF2\u7ECF\u5F80\u670B\u53CB\u90A3\u8FB9\u8D70\u3002"
    shot: 27
    focus: 0.5
    fade: 0
  - id: note-v1-07
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u5F53\u665A \xB7 \u5973\u751F\u5BBF\u820D"
    shot: 28
    focus: 0.5
    fade: 1
  - id: note-v1-08
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u674E\u665A\u4E91\u5750\u5230\u4E66\u684C\u65C1\uFF0C\u6253\u5F00\u90A3\u5F20\u7EB8\u3002"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-09
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u7EB8\u6761"
    text: "Mg + ZnSO<sub>4</sub> \u2192 MgSO<sub>4</sub> + Zn"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-10
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u8FD9\u4E0D\u662F\u7F6E\u6362\u53CD\u5E94\u5417\u2026\u2026"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-11
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u5BA4\u53CB\u4E00"
    text: "\u4EC0\u4E48\u4E1C\u897F\uFF0C\u85CF\u90A3\u4E48\u5FEB\uFF1F"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-12
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u6CA1\u85CF\u3002"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-13
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u5BA4\u53CB\u4E8C"
    text: "\u5316\u5B66\uFF1F\u4F60\u4EEC\u56DE\u5BBF\u820D\u8FD8\u7ED9\u5F7C\u6B64\u7559\u9898\u554A\uFF1F"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-14
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u5BA4\u53CB\u4E09"
    text: "\u8FD9\u4E2A\u6211\u89C1\u8FC7\u3002\u4F60\u7684\u9541\u2014\u2014\u7F8E\uFF0C\u5077\u8D70\u4E86\u6211\u7684\u950C\u2014\u2014\u5FC3\u3002"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-15
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u53E6\u5916\u4E24\u4EBA\u62D6\u957F\u4E00\u58F0\u201C\u54E6\u201D\u3002\u674E\u665A\u4E91\u628A\u7EB8\u538B\u5728\u672C\u5B50\u4E0B\u9762\u3002"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-16
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u5BA4\u53CB\u4E8C"
    text: "\u51CC\u8D6B\u7ED9\u7684\u5427\uFF1F\u5C31\u90A3\u4E2A\u88AB\u8C03\u5230\u8BB2\u53F0\u8FB9\u4E0A\u7684\u3002"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-17
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u5BA4\u53CB\u4E00"
    text: "\u6211\u770B\u4ED6\u5929\u5929\u627E\u4F60\u95EE\u82F1\u8BED\u3002"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-18
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u4E5F\u6CA1\u6709\u5929\u5929\u2026\u2026\u6211\u4E5F\u95EE\u4ED6\u6570\u5B66\u7684\u3002"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-19
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u5BA4\u53CB\u4E09"
    text: "\u90A3\u660E\u5929\u6211\u66FF\u4F60\u95EE\u4ED6\uFF0C\u8FD9\u9898\u4EC0\u4E48\u610F\u601D\uFF1F"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-20
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: "\u674E\u665A\u4E91"
    text: "\u522B\u3002"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-21
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u5979\u7ACB\u523B\u62AC\u8D77\u5934\u3002\u5BA4\u53CB\u7B11\u8D77\u6765\uFF0C\u6CA1\u6709\u7EE7\u7EED\u903C\u95EE\u3002"
    shot: 28
    focus: 0.5
    fade: 0
  - id: note-v1-22
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u7184\u706F\u524D\uFF0C\u5979\u628A\u7EB8\u4ECE\u672C\u5B50\u91CC\u53D6\u51FA\u6765\u3002"
    shot: 29
    focus: 0.5
    fade: 1
  - id: note-v1-23
    requiresMathAnswer: 0
    requiresRoute: 0
    interaction: 0
    speaker: 
    text: "\u5979\u6CBF\u7740\u539F\u6765\u7684\u6298\u75D5\u91CD\u65B0\u6298\u597D\uFF0C\u653E\u56DE\u672C\u5B50\u91CC\u3002"

# Normalize text in Git; check out Windows scripts with Windows endings.
* text=auto
*.md text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.asmdef text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.wav binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
